generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}

model Advertiser {
  id           String   @id
  businessName String
  email        String   @unique
  phone        String
  createdAt    DateTime @default(now())

  ads      Ad[]
  orders   Order[]
  products Product[]

  sellerSubscription SellerSubscription?
}
model SellerSubscription {
  id           String   @id @default(cuid())
  advertiserId String   @unique

  planName String  @default("Seller")
  amount   Decimal @db.Decimal(10, 2)

  status String @default("pending")

  paymentMethod    String?
  paymentReference String?

  startsAt  DateTime?
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

 advertiser Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([expiresAt])
}
model Product {
  id           String   @id @default(cuid())
  name         String
  description  String?
  price        Decimal  @db.Decimal(10, 2)
  imageUrl     String?
  category     String   @default("Other")
  location     String?
  stock        Int      @default(1)
  status       String   @default("active")
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id])

  @@index([category])
  @@index([location])
  @@index([status])
  @@index([advertiserId])
}

model Ad {
  id           String   @id
  title        String
  mediaUrl     String
  mediaType    String
  duration     Int?
  category     String   @default("Other")
  subcategory  String   @default("Other Listings")
  location     String
  status       String   @default("pending")
  views        Int      @default(0)
  isFeatured   Boolean  @default(false)
  advertiserId String
  createdAt    DateTime @default(now())

  advertiser Advertiser @relation(fields: [advertiserId], references: [id])
}



model Order {
  id           String @id @default(cuid())
  orderNumber  String @unique
  advertiserId String

  packageId   String
  packageName String

  billboardPrice        Decimal @db.Decimal(10, 2)
  socialMediaTotal      Decimal @default(0) @db.Decimal(10, 2)
  campaignManagementFee Decimal @default(0) @db.Decimal(10, 2)
  totalPrice            Decimal @db.Decimal(10, 2)

  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  advertiser Advertiser @relation(fields: [advertiserId], references: [id])
  payment    Payment?
}

model Payment {
  id      String @id @default(cuid())
  orderId String @unique

  paymentMethod    String
  paymentReference String

  amount Decimal @db.Decimal(10, 2)

  status     String    @default("pending")
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id])
}
model Admin {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}